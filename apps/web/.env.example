# ============================================================
# iRexPro Web App (apps/web) — Staging/Production Environment
# Copy to .env.local (Next.js client+server convention).
# NEVER commit .env.local to version control.
# ============================================================

# ── API base URL ────────────────────────────────────────────────────────────
# The public NestJS API base URL the frontend calls.
# Staging-verified: https://irexpro.lightworldtech.com/api/v1
# Local dev:        http://127.0.0.1:3010/api/v1
NEXT_PUBLIC_API_BASE_URL=https://irexpro.lightworldtech.com/api/v1

# ── Frontend origin ─────────────────────────────────────────────────────────
# The public URL of the frontend itself (canonical URLs, payment callbacks).
NEXT_PUBLIC_APP_URL=https://irexpro.lightworldtech.com

# ── Environment flag ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=staging

# ============================================================
# VARIABLES THAT MUST NEVER APPEAR IN FRONTEND ENV (backend-only secrets):
# ============================================================
# Do NOT add any of these to apps/web/.env.local:
#   AI_ENGINE_URL               — internal-only (127.0.0.1:8011); never frontend
#   NESTJS_INTERNAL_API_KEY     — service-to-service (AI engine → API); never frontend
#   BROKER_ENCRYPTION_KEY       — backend AES-256-GCM key; never frontend
#   DB_PASSWORD                 — PostgreSQL; backend only
#   JWT_SECRET                  — backend signing key; never frontend
#   PAYSTACK_SECRET_KEY         — backend; never frontend (public key is ok)
#   PAYSTACK_WEBHOOK_SECRET     — backend; never frontend
#   STRIPE_SECRET_KEY           — backend; never frontend (publishable key is ok)
#   STRIPE_WEBHOOK_SECRET       — backend; never frontend
#   METAAPI_TOKEN               — backend; never frontend
#   REDIS_PASSWORD              — backend; never frontend
