# ============================================================
# iRexPro API — Environment Variables
# Copy to .env and fill in values for your environment.
# NEVER commit .env to version control.
#
# PRODUCTION DEPLOYMENT:
#   See docs/runbooks/production-deployment-vps-webuzo.md for the full
#   production setup procedure. Every CHANGE_ME_* and PLACEHOLDER value
#   below MUST be replaced with a strong generated secret before going live.
#   See docs/runbooks/secrets-never-committed.md for the secrets policy.
# ============================================================

# Application
# Production: set NODE_ENV=production (disables Swagger, enables prod behaviour)
# Staging-verified (Sprint 21): APP_PORT=3010 (see docs/runbooks/production-deployment-vps-webuzo.md §1.4)
NODE_ENV=development
APP_PORT=3000
APP_HOST=0.0.0.0
APP_NAME=iRexPro API
APP_VERSION=0.1.0
API_PREFIX=api/v1
# Production/staging: set to your real frontend origin(s) only.
# Staging-verified (Sprint 23): two public domains — the client web app and the
# admin portal run on separate subdomains. The admin portal is cross-origin with
# the API, so BOTH origins must be listed or admin browser requests are blocked.
#   CORS_ORIGINS=https://irexpro.lightworldtech.com,https://irexproadmin.lightworldtech.com
# During local frontend dev you may temporarily add http://localhost:3005,http://localhost:3006.
# See docs/runbooks/production-deployment-vps-webuzo.md §8.5.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# JWT — Use RS256 in production. For dev, symmetric HS256 is acceptable.
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_SECRET_IN_DEV
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# For RS256 (production):
# JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

# PostgreSQL
# Production: DB_NAME=irexpro_prod, DB_SSL=true, DB_SYNCHRONIZE=false (NEVER true in prod),
#   strong generated DB_PASSWORD, DB_MAX_CONNECTIONS tuned to VPS size.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=irexpro_dev
DB_USER=irexpro
DB_PASSWORD=CHANGE_ME_DEV_PASSWORD
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_MAX_CONNECTIONS=10

# Redis
# Production: set a strong REDIS_PASSWORD; keep REDIS_DB=0 (AI engine uses REDIS_DB=1).
#   Redis must bind to localhost and have requirepass set.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=irexpro:

# Swagger
# Production: SWAGGER_ENABLED=false (main.ts also disables Swagger when NODE_ENV=production)
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
SWAGGER_TITLE=iRexPro API
SWAGGER_DESCRIPTION=iRexPro Global AI Forex Trading Platform — API Documentation
SWAGGER_VERSION=0.1.0

# Argon2 password hashing
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Security
BCRYPT_ROUNDS=12
COOKIE_SECRET=CHANGE_ME_COOKIE_SECRET

# ============================================================
# Payment Providers — placeholder secrets (Sprint 5-6)
# ============================================================
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-PLACEHOLDER
FLUTTERWAVE_WEBHOOK_SECRET=PLACEHOLDER
HUBTEL_CLIENT_ID=PLACEHOLDER
HUBTEL_CLIENT_SECRET=PLACEHOLDER

# ============================================================
# Paystack — sandbox checkout + webhook integration (Sprint 15)
# PAYSTACK_ENABLED must be explicitly 'true' to allow live checkout/webhook
# verification — the provider fails closed while disabled or unconfigured.
# PAYSTACK_SECRET_KEY must ONLY ever live in your local .env — never commit it,
# never log it, never return it in any API response.
# ============================================================
PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=sk_test_PLACEHOLDER
PAYSTACK_PUBLIC_KEY=pk_test_PLACEHOLDER
PAYSTACK_WEBHOOK_SECRET=PLACEHOLDER
PAYSTACK_BASE_URL=https://api.paystack.co
# Staging/production: point at the frontend payment callback page.
# Staging-verified (Sprint 22): https://irexpro.lightworldtech.com/payments/callback
# The callback page is DISPLAY-ONLY — it never marks payments as paid.
# See docs/integration/frontend-staging-integration.md §3.
PAYSTACK_CALLBACK_URL=http://localhost:3001/payments/callback

# ============================================================
# Stripe — sandbox checkout + webhook integration (Sprint 17)
# STRIPE_ENABLED must be explicitly 'true' to allow live checkout/webhook
# verification — the provider fails closed while disabled or unconfigured.
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET must ONLY ever live in your local
# .env — never commit them, never log them, never return them in any API response.
# ============================================================
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_PUBLISHABLE_KEY=pk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER
STRIPE_BASE_URL=https://api.stripe.com
# Staging/production: point at the frontend payment redirect pages.
# Staging-verified (Sprint 22):
#   STRIPE_SUCCESS_URL=https://irexpro.lightworldtech.com/payments/success
#   STRIPE_CANCEL_URL=https://irexpro.lightworldtech.com/payments/cancel
# These pages are DISPLAY-ONLY — they never mark payments as paid. Payment truth
# is backend-only via the verified Stripe webhook.
# See docs/integration/frontend-staging-integration.md §3.
STRIPE_SUCCESS_URL=http://localhost:3001/payments/success
STRIPE_CANCEL_URL=http://localhost:3001/payments/cancel

# ============================================================
# SMS Providers — placeholder secrets (Sprint 5-6)
# ============================================================
TWILIO_ACCOUNT_SID=PLACEHOLDER
TWILIO_AUTH_TOKEN=PLACEHOLDER
TWILIO_FROM_NUMBER=+15005550006
ARKESEL_API_KEY=PLACEHOLDER
HUBTEL_SMS_CLIENT_ID=PLACEHOLDER
HUBTEL_SMS_CLIENT_SECRET=PLACEHOLDER

# ============================================================
# Broker Adapters — Sprint 3
# ============================================================
# Credential encryption key — AES-256-GCM, min 32 chars.
# In production: rotate via KMS, NEVER commit plaintext.
BROKER_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_ENCRYPTION_KEY_!!

# MetaAPI Platform Token — ONE token for the entire platform (not per-user).
# Obtain from: https://app.metaapi.cloud/api-access/generate-token
# In production: store in AWS Secrets Manager or HashiCorp Vault.
# Leave blank to disable live MetaTrader connections (dev/test).
METAAPI_TOKEN=

# ============================================================
# Internal Service-to-Service Auth — Sprint 7+
# Must match NESTJS_INTERNAL_API_KEY in services/ai-engine/.env
# ============================================================
NESTJS_INTERNAL_API_KEY=dev_internal_key_change_me

# ============================================================
# AI Engine Scheduler Coordination — Sprint 8
# NestJS notifies Python AI engine on trading session start/stop
# ============================================================
AI_ENGINE_BASE_URL=http://localhost:8001/api/v1
AI_ENGINE_SCHEDULER_ENABLED=false

# ============================================================
# Password Reset Delivery — Sprint 28
# All optional. If not set, the API returns a generic success message but
# does NOT deliver the reset token/code. Set these to enable real delivery.
# ============================================================

# Base URL of the web app — used to build the reset link:
#   ${WEB_BASE_URL}/reset-password?token=...
# All reset links (web + admin) use this single base URL. Admin users reset
# via the web reset page, then log in to the admin portal.
# Example: https://irexpro.lightworldtech.com
WEB_BASE_URL=

# Base URL of the admin app (optional — for future admin-specific reset links).
# Currently reset links point to the web app for all users.
# Example: https://irexproadmin.lightworldtech.com
ADMIN_BASE_URL=

# SMTP connection URL for email delivery (nodemailer).
# When set, password reset emails are sent via this SMTP server.
# When empty, the API logs a safe warning and does NOT send email (the
# generic API response is still returned — no account enumeration).
# Format: smtps://user:password@smtp.example.com:465  (smtps = TLS)
#      or: smtp://user:password@smtp.example.com:587  (smtp + STARTTLS)
EMAIL_SMTP_URL=

# From address for password reset emails.
# Either EMAIL_FROM or EMAIL_FROM_ADDRESS works (EMAIL_FROM takes precedence).
EMAIL_FROM=no-reply@irexpro.com
EMAIL_FROM_ADDRESS=no-reply@irexpro.com
