# ============================================================
# iRexPro API — Environment Variables
# Copy to .env and fill in values for your environment.
# NEVER commit .env to version control.
# ============================================================

# Application
NODE_ENV=development
APP_PORT=3000
APP_HOST=0.0.0.0
APP_NAME=iRexPro API
APP_VERSION=0.1.0
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# JWT — Use RS256 in production. For dev, symmetric HS256 is acceptable.
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_SECRET_IN_DEV
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# For RS256 (production):
# JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=irexpro_dev
DB_USER=irexpro
DB_PASSWORD=CHANGE_ME_DEV_PASSWORD
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_MAX_CONNECTIONS=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=irexpro:

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
SWAGGER_TITLE=iRexPro API
SWAGGER_DESCRIPTION=iRexPro Global AI Forex Trading Platform — API Documentation
SWAGGER_VERSION=0.1.0

# Argon2 password hashing
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Security
BCRYPT_ROUNDS=12
COOKIE_SECRET=CHANGE_ME_COOKIE_SECRET

# ============================================================
# Payment Providers — placeholder secrets (Sprint 5-6)
# ============================================================
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER
PAYSTACK_SECRET_KEY=sk_test_PLACEHOLDER
PAYSTACK_WEBHOOK_SECRET=PLACEHOLDER
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-PLACEHOLDER
FLUTTERWAVE_WEBHOOK_SECRET=PLACEHOLDER
HUBTEL_CLIENT_ID=PLACEHOLDER
HUBTEL_CLIENT_SECRET=PLACEHOLDER

# ============================================================
# SMS Providers — placeholder secrets (Sprint 5-6)
# ============================================================
TWILIO_ACCOUNT_SID=PLACEHOLDER
TWILIO_AUTH_TOKEN=PLACEHOLDER
TWILIO_FROM_NUMBER=+15005550006
ARKESEL_API_KEY=PLACEHOLDER
HUBTEL_SMS_CLIENT_ID=PLACEHOLDER
HUBTEL_SMS_CLIENT_SECRET=PLACEHOLDER

# ============================================================
# Broker Adapters — Sprint 3
# ============================================================
# Credential encryption key — AES-256-GCM, min 32 chars.
# In production: rotate via KMS, NEVER commit plaintext.
BROKER_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_ENCRYPTION_KEY_!!

# MetaAPI Platform Token — ONE token for the entire platform (not per-user).
# Obtain from: https://app.metaapi.cloud/api-access/generate-token
# In production: store in AWS Secrets Manager or HashiCorp Vault.
# Leave blank to disable live MetaTrader connections (dev/test).
METAAPI_TOKEN=

# ============================================================
# Internal Service-to-Service Auth — Sprint 7
# Must match NESTJS_INTERNAL_API_KEY in services/ai-engine/.env
# ============================================================
NESTJS_INTERNAL_API_KEY=dev_internal_key_change_me
