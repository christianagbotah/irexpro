# ============================================================
# iRexPro Admin Portal (apps/admin) — Staging/Production Environment
# Copy to .env.local. NEVER commit .env.local.
# ============================================================

# ── API base URL ────────────────────────────────────────────────────────────
# Same public API as the client web app.
# Staging-verified: https://irexpro.lightworldtech.com/api/v1
NEXT_PUBLIC_API_BASE_URL=https://irexpro.lightworldtech.com/api/v1

# ── Admin portal origin ─────────────────────────────────────────────────────
# If admin runs on the same domain under /admin, use the same origin.
# If admin runs on a separate subdomain later, use that subdomain.
NEXT_PUBLIC_APP_URL=https://irexpro.lightworldtech.com

# ── Environment flag ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=staging

# ============================================================
# VARIABLES THAT MUST NEVER APPEAR IN ADMIN ENV (backend-only secrets):
# ============================================================
#   AI_ENGINE_URL               — internal-only; never frontend
#   NESTJS_INTERNAL_API_KEY     — service-to-service; never frontend
#   BROKER_ENCRYPTION_KEY       — backend; never frontend
#   DB_PASSWORD                 — PostgreSQL; backend only
#   JWT_SECRET                  — backend; never frontend
#   PAYSTACK_SECRET_KEY         — backend; never frontend
#   PAYSTACK_WEBHOOK_SECRET     — backend; never frontend
#   STRIPE_SECRET_KEY           — backend; never frontend
#   STRIPE_WEBHOOK_SECRET       — backend; never frontend
#   METAAPI_TOKEN               — backend; never frontend
#   REDIS_PASSWORD              — backend; never frontend
