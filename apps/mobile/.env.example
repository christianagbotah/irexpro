# ============================================================
# iRexPro Mobile App (apps/mobile) — Staging/Production Environment
# Copy to .env. NEVER commit .env.
# Expo inlines EXPO_PUBLIC_* vars at build time.
# ============================================================

# ── API base URL ────────────────────────────────────────────────────────────
# The public NestJS API base URL the mobile app calls.
# Staging-verified: https://irexpro.lightworldtech.com/api/v1
EXPO_PUBLIC_API_BASE_URL=https://irexpro.lightworldtech.com/api/v1

# ── Environment flag ────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=staging

# ============================================================
# VARIABLES THAT MUST NEVER APPEAR IN MOBILE ENV (backend-only secrets):
# ============================================================
#   AI_ENGINE_URL               — internal-only (127.0.0.1:8011); never mobile
#   NESTJS_INTERNAL_API_KEY     — service-to-service; never mobile
#   BROKER_ENCRYPTION_KEY       — backend; never mobile
#   DB_PASSWORD                 — PostgreSQL; backend only
#   JWT_SECRET                  — backend; never mobile
#   PAYSTACK_SECRET_KEY         — backend; never mobile
#   PAYSTACK_WEBHOOK_SECRET     — backend; never mobile
#   STRIPE_SECRET_KEY           — backend; never mobile
#   STRIPE_WEBHOOK_SECRET       — backend; never mobile
#   METAAPI_TOKEN               — backend; never mobile
#   REDIS_PASSWORD              — backend; never mobile
