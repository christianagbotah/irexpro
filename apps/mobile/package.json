{
  "name": "@irexpro/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "iRexPro — native mobile app foundation for iOS and Android (Expo + React Native + TypeScript).",
  "main": "App.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "validate:release-config": "node ./scripts/validate-release-config.cjs",
    "release:preflight": "node ./scripts/validate-release-config.cjs --require-project-id"
  },
  "dependencies": {
    "@irexpro/api-client": "workspace:*",
    "@irexpro/types": "workspace:*",
    "expo": "~52.0.49",
    "expo-secure-store": "~14.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "~18.3.31",
    "typescript": "~5.3.3"
  }
}
