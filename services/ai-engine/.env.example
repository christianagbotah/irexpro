# iRexPro AI Engine — Environment Variables
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env to version control.

# ─── Service Identity ────────────────────────────────────────────────────────
AI_ENGINE_ENV=development
AI_ENGINE_PORT=8001
AI_ENGINE_SERVICE_NAME=irexpro-ai-engine
AI_ENGINE_VERSION=0.1.0

# ─── NestJS API Integration ───────────────────────────────────────────────────
NESTJS_API_BASE_URL=http://localhost:3000/api/v1
NESTJS_AI_SIGNAL_ENDPOINT=/ai/internal/signals
NESTJS_MARKET_DATA_ENDPOINT=/market-data/internal/ohlcv
# SECURITY: Change this key before any deployment. Must match NestJS NESTJS_INTERNAL_API_KEY.
NESTJS_INTERNAL_API_KEY=dev_internal_key_change_me

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=irexpro_redis_dev_password
REDIS_DB=1
AI_REDIS_KEY_PREFIX=ai
AI_OHLCV_CACHE_TTL_SECONDS=300

# ─── AI Engine Behaviour ──────────────────────────────────────────────────────
AI_DEFAULT_MODEL_VERSION=baseline-xgboost-v0.1.0
AI_MIN_CONFIDENCE_SCORE=0.60
# IMPORTANT: AI_SIGNAL_MODE must be 'paper' or 'sandbox'.
# 'live' mode is NOT supported and will be rejected.
AI_SIGNAL_MODE=paper
AI_ALLOW_MOCK_MARKET_DATA=false

# ─── Scheduler (disabled by default) ─────────────────────────────────────────
AI_SCHEDULER_ENABLED=false
AI_SIGNAL_INTERVAL_SECONDS=60

# ─── CORS (comma-separated) ───────────────────────────────────────────────────
AI_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
